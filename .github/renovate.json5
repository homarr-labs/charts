{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  labels: [
    'dependencies',
    '{{datasource}}',
    '{{updateType}}',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)Chart\\.yaml$/',
      ],
      matchStrings: [
        '# ?renovate datasource=(?<datasource>.+?) depName=(?<depName>.+)\\n.+: ["\']?(?<currentValue>.+?)["\']?\\n',
      ],
    },
  ],
  packageRules: [
    {
      matchDatasources: [
        'helm',
      ],
      commitMessageTopic: '{{depName}} Helm release',
    },
  ],
  baseBranches: [
    'dev',
  ],
}
